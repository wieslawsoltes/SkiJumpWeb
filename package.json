{
  "name": "ski-jump-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent, dependency-free classic ski jumping recreation with WebGPU rendering.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:all": "node tools/pack.mjs",
    "check": "node tools/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "pretest": "node tools/link.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/SkiJumpWeb.git"
  },
  "homepage": "https://wieslawsoltes.github.io/SkiJumpWeb/",
  "bugs": {
    "url": "https://github.com/wieslawsoltes/SkiJumpWeb/issues"
  }
}
